{
    "name": "runopencode/intent-bundle",
    "description": "Symfony integration with runopencode/intent component.",
    "license": "MIT",
    "authors": [
        {
            "name": "Nikola Svitlica a.k.a TheCelavi",
            "email": "thecelavi@runopencode.com"
        },
        {
            "name": "Stefan Veljancic",
            "email": "veljancicstefan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "runopencode/intent": "^0.2",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/doctrine-bridge": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "symfony/console": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "RunOpenCode\\Bundle\\IntentBundle\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../Component/Logger",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Dataset",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Stream",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Bitmask",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Intent",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/XmlParser",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Query",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Component/Metadata",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Bundle/MetadataBundle",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Bundle/QueryBundle",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../../Bundle/LoggerBundle",
            "options": {
                "symlink": false
            }
        }
    ],
    "suggest": {
        "doctrine/dbal": "Required when intents are stored within a database table.",
        "doctrine/orm": "Required to contribute the intent storage table to the schema generated by Doctrine ORM.",
        "symfony/console": "Required to register the console command which removes expired intents from the storage."
    },
    "config": {
        "sort-packages": true
    },
    "version": "0.2",
    "minimum-stability": "dev",
    "prefer-stable": true
}
